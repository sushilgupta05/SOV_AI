# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai          # openai | azure
LLM_MODEL=gpt-4o             # for azure: your deployment name
LLM_TIMEOUT_S=30
LLM_ENABLED=true             # false = deterministic classifier only (offline demo)
MASK_SAMPLES=true            # mask PII-like sample values before they reach the LLM

OPENAI_API_KEY=

# Azure OpenAI (when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
